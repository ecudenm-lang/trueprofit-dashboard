# Copia este archivo como .env (local) o pon estas variables en Vercel.
# NO subas el .env real a GitHub. Aquí solo van placeholders.

# === Shopify (Partner app) ===
SHOPIFY_API_KEY=tu_client_id
SHOPIFY_API_SECRET=tu_client_secret_shpss_xxx
SHOPIFY_APP_URL=https://TU-APP.vercel.app
SCOPES=read_products,read_orders,read_inventory

# === Base de datos de sesión (Supabase Postgres) ===
# Dashboard Supabase -> Project Settings -> Database -> Connection string (URI).
# DATABASE_URL: Transaction pooler (puerto 6543) para serverless.
# DIRECT_URL: conexión directa (puerto 5432) para migraciones.
DATABASE_URL=postgresql://postgres.grwplyvdcwcknnwfypbo:TU_DB_PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.grwplyvdcwcknnwfypbo:TU_DB_PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# === Lectura del P&L (Supabase REST) ===
SUPABASE_URL=https://grwplyvdcwcknnwfypbo.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
